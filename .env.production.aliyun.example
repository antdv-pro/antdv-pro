APP_NAME=enterprise-system
APP_VERSION=latest
NODE_ENV=production
TZ=Asia/Shanghai

# Bind the web container to the standard HTTP port so the domain can open directly.
WEB_PORT=80
PORT=3000

VITE_APP_NAME=企业管理系统
VITE_APP_BASE=/
VITE_APP_BASE_API=/api
VITE_APP_BASE_URL=/api
VITE_APP_LOAD_ROUTE_WAY=BACKEND
VITE_GLOB_APP_TITLE=企业管理系统

DB_CLIENT=mysql
DB_HOST=your-rds-internal-host.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_CONNECT_TIMEOUT_MS=5000
DB_NAME=enterprise_system
DB_USER=enterprise_app
DB_PASSWORD=replace_with_strong_rds_password
DB_REQUIRED=true

REDIS_HOST=your-redis-internal-host.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
SESSION_STORE=redis
SESSION_TTL_SECONDS=28800

JWT_SECRET=replace_with_at_least_32_random_chars
SESSION_SECRET=replace_with_at_least_32_random_chars
ADMIN_INITIAL_PASSWORD=replace_with_one_time_strong_admin_password
PASSWORD_HASH_ALGORITHM=sha256

OSS_PROVIDER=aliyun
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-oss-bucket
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace_with_ram_access_key
OSS_ACCESS_KEY_SECRET=replace_with_ram_secret
OSS_UPLOAD_DIR=enterprise-system
UPLOAD_DIR=/app/uploads
WECOM_APPROVAL_DATA_FILE=/app/uploads/.private/wecom-approval.json
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.xlsx,.xls,.csv,.doc,.docx

LOG_DIR=/app/logs
LOG_LEVEL=info
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14

GPS_808_BASE_URL=https://www.qhzfclw.com
GPS_808_USERNAME=
GPS_808_PASSWORD=
GPS_808_TOKEN=
GPS_SYNC_SCHEDULER_ENABLED=true
GPS_LOCATION_SYNC_INTERVAL_MS=120000
GPS_ALARM_SYNC_INTERVAL_MS=300000
GPS_DEVICE_SYNC_INTERVAL_MS=3600000

# Server-side AMap Web Service key for precise address geocoding.
AMAP_WEB_SERVICE_KEY=change_me_amap_web_service_key
