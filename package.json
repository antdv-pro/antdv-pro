{
  "name": "antdv-pro",
  "type": "module",
  "version": "1.5.0",
  "packageManager": "pnpm@10.30.2",
  "author": "aibayanyu <aibayanyu@qq.com>",
  "repository": "antdv-pro/antdv-pro",
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build",
    "clear:vercel": "rm -rf ./vercel.json",
    "build:vercel": "run-s clear:vercel",
    "start": "node dist/servers/app.js",
    "deploy:check": "node deploy/scripts/check-env.mjs",
    "migrate:mysql": "node scripts/apply-mysql-migrations.mjs",
    "verify:mysql": "node scripts/verify-mysql-migrations.mjs",
    "verify:integrity": "node scripts/verify-cross-module-integrity.mjs",
    "verify:integrity:production": "sh deploy/scripts/verify-cross-module-integrity.sh",
    "probe:approval": "node scripts/probe-production-approval.mjs",
    "import:system:mysql": "node scripts/import-system-json-to-mysql.mjs",
    "import:business:mysql": "node scripts/import-business-json-to-mysql.mjs",
    "clean:fake:mysql": "node scripts/clean-fake-data-mysql.mjs",
    "repair:data:mysql": "node scripts/repair-production-data.mjs",
    "verify:live": "node scripts/verify-live-site.mjs",
    "backup:mysql": "sh deploy/scripts/backup-mysql.sh",
    "backup:uploads": "sh deploy/scripts/backup-uploads.sh",
    "backup:production": "sh deploy/scripts/backup-production.sh",
    "health:production": "sh deploy/scripts/check-production-health.sh",
    "deploy:api:light": "sh deploy/scripts/deploy-api-light.sh",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bump:patch": "changelogen --bump --output CHANGELOG.md --release",
    "bump:minor": "changelogen --bump --output CHANGELOG.md --release --minor",
    "bump:major": "changelogen --bump --output CHANGELOG.md --release --major",
    "prepare": "husky",
    "dir-tree": "esno ./scripts/dir-tree",
    "gen:uno": "esno ./scripts/gen-unocss",
    "toJS": "esno scripts/to-js"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/g2plot": "^2.4.35",
    "@antv/l7": "^2.23.2",
    "@ctrl/tinycolor": "^4.2.0",
    "@v-c/utils": "^0.0.26",
    "@vueuse/core": "^10.11.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.5",
    "dayjs": "^1.11.19",
    "lodash-es": "^4.17.23",
    "mitt": "^3.0.1",
    "mysql2": "^3.22.5",
    "opencc-js": "^1.4.1",
    "pdfjs-dist": "^6.1.200",
    "pinia": "^2.3.1",
    "vue": "^3.5.29",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.34",
    "@types/treeify": "^1.0.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.6",
    "antdv-component-resolver": "^1.0.8",
    "antdv-style": "0.0.1-beta.4",
    "changelogen": "^0.5.7",
    "cross-env": "^7.0.3",
    "directory-tree": "^3.6.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.3",
    "eslint-plugin-format": "^1.5.0",
    "esno": "^0.17.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.3.3",
    "h3": "^2.0.1-rc.14",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^22.1.0",
    "less": "^4.5.1",
    "lint-staged": "^14.0.1",
    "lodash": "^4.17.23",
    "mock-h3": "0.0.1-beta.12",
    "npm-run-all": "^4.1.5",
    "picocolors": "^1.1.1",
    "treeify": "^1.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "unocss": "^66.6.1",
    "unocss-preset-chinese": "^0.3.3",
    "unocss-preset-ease": "^0.0.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-config": "^0.1.5",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^8.0.0-beta.15",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.5"
  },
  "lint-staged": {
    "**/*.{vue,ts,js,jsx,tsx}": "eslint src --fix"
  }
}
